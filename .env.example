POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker
DATABASE_URL=postgresql://postgres:postgres@db:5432/expense_tracker

# Get free Sandbox credentials at https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Create a Google OAuth client at https://console.cloud.google.com
# Authorized redirect URI to register there: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -hex 32 (or python3 -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET_KEY=
FRONTEND_URL=http://localhost:5173

# Encrypts Plaid access tokens at rest. Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call the API with credentials
# (e.g. "https://app.example.com,https://staging.example.com"). Defaults to
# the Vite dev server if unset.
CORS_ORIGINS=http://localhost:5173

# Session cookie flags. Leave both at their defaults for local HTTP dev.
# In production, always set SESSION_COOKIE_SECURE=true (cookie only sent over
# HTTPS). Set SESSION_COOKIE_SAMESITE=none only if the frontend and API are on
# different top-level domains (not subdomains of the same site) - it must be
# paired with SESSION_COOKIE_SECURE=true or browsers will reject the cookie.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
